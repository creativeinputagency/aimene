<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<title>Business with Aimene Projects</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Readex+Pro:wght@300..700&display=swap">
<style>
/* Layout: app shell. Left rail on desktop, bottom tab bar on phones. Four views: Overview, Projects, Ads budget, Clients. Greige neutrals and charcoal ink with a silk-blue accent, taken from the Business with Aimene page. */
:root{
  --bg:#E9E7E3; --surface:#F6F5F2; --surface-2:#EEECE8; --ink:#17181C; --muted:#636670; --line:#D7D4CE;
  --accent:#2457D6; --accent-ink:#FFFFFF; --accent-bg:#DCE5FB;
  --good:#17734D; --good-bg:#D5EADD; --warn:#80530A; --warn-bg:#F4E3BD; --bad:#A3321B; --bad-bg:#F5D8CF;
  --shadow:0 1px 2px rgba(20,20,25,.06),0 10px 28px rgba(20,20,25,.07);
  --display:'Bricolage Grotesque','Readex Pro','Segoe UI',Tahoma,system-ui,sans-serif;
  --body:'Readex Pro','Segoe UI',Tahoma,system-ui,sans-serif;
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --bg:#111215; --surface:#1A1C21; --surface-2:#22252B; --ink:#ECEBE8; --muted:#9A9DA6; --line:#2D3037;
  --accent:#7D9DFF; --accent-ink:#0D1424; --accent-bg:#222D55;
  --good:#6FD0A0; --good-bg:#1A3428; --warn:#E6B65C; --warn-bg:#3A2E14; --bad:#F09A86; --bad-bg:#412219;
  --shadow:0 1px 2px rgba(0,0,0,.4),0 10px 28px rgba(0,0,0,.35); color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#111215; --surface:#1A1C21; --surface-2:#22252B; --ink:#ECEBE8; --muted:#9A9DA6; --line:#2D3037;
  --accent:#7D9DFF; --accent-ink:#0D1424; --accent-bg:#222D55;
  --good:#6FD0A0; --good-bg:#1A3428; --warn:#E6B65C; --warn-bg:#3A2E14; --bad:#F09A86; --bad-bg:#412219;
  --shadow:0 1px 2px rgba(0,0,0,.4),0 10px 28px rgba(0,0,0,.35); color-scheme:dark}

*{box-sizing:border-box}
body{background:var(--bg);color:var(--ink);font-family:var(--body);font-size:14px;line-height:1.5;
  padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));padding-block:0}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:30;background:var(--bg)}
h1,h2,h3,p{margin:0}
button,input,select{font:inherit;color:inherit}
button{cursor:pointer}
small{font-size:.72em;font-weight:500;color:var(--muted);letter-spacing:.04em}
bdi{unicode-bidi:isolate}
.num{font-variant-numeric:tabular-nums}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.ic{width:20px;height:20px;flex:none;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}

/* shell */
.app{display:grid;grid-template-columns:minmax(0,1fr);min-height:100vh;max-width:1180px;margin:0 auto}
.rail{position:fixed;left:0;right:0;bottom:0;z-index:20;display:flex;gap:4px;justify-content:space-around;
  background:var(--surface);border-top:1px solid var(--line);
  padding:6px max(10px,env(safe-area-inset-right,0px)) calc(6px + env(safe-area-inset-bottom,0px)) max(10px,env(safe-area-inset-left,0px))}
.brand{display:none}
.tab{flex:1;display:flex;flex-direction:column;align-items:center;gap:2px;padding:8px 4px;border:0;border-radius:12px;background:none;
  color:var(--muted);font-size:11px;font-weight:500;letter-spacing:.02em}
.tab[aria-current="page"]{color:var(--accent);background:var(--accent-bg)}
main{min-width:0;padding-bottom:150px}
.top{position:sticky;top:env(safe-area-inset-top,0px);z-index:25;background:var(--bg);display:flex;align-items:flex-end;justify-content:space-between;gap:12px;padding:18px 0 12px}
.eyebrow{font-size:11px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:var(--muted)}
.top h1{font-family:var(--display);font-weight:700;font-size:28px;line-height:1.1;letter-spacing:-.01em;text-wrap:balance}
.iconbtn{display:grid;place-items:center;width:40px;height:40px;border-radius:12px;border:1px solid var(--line);background:var(--surface);color:var(--ink)}
.banner{margin:0 0 12px;padding:12px 14px;border-radius:12px;background:var(--warn-bg);color:var(--warn);font-weight:500}

/* generic pieces */
.card{background:var(--surface);border:1px solid var(--line);border-radius:18px;box-shadow:var(--shadow);padding:16px}
.grid{display:grid;gap:12px}
.kpis{grid-template-columns:repeat(2,minmax(0,1fr))}
.kpi{padding:14px 16px;display:flex;flex-direction:column;gap:6px;min-width:0}
.kpi b{font-family:var(--display);font-size:26px;font-weight:700;line-height:1.1;letter-spacing:-.01em;overflow-wrap:anywhere}
.kpi .eyebrow{font-size:10.5px}
.sec{display:flex;align-items:center;justify-content:space-between;gap:10px;margin:22px 0 10px}
.sec h2{font-family:var(--display);font-size:18px;font-weight:700}
.sec .sub{color:var(--muted);font-size:12px}
.chip{display:inline-flex;align-items:center;gap:5px;padding:3px 10px;border-radius:99px;font-size:12px;font-weight:500;background:var(--surface-2);color:var(--muted);white-space:nowrap}
.chip.good{background:var(--good-bg);color:var(--good)}
.chip.warn{background:var(--warn-bg);color:var(--warn)}
.chip.bad{background:var(--bad-bg);color:var(--bad)}
.chip.acc{background:var(--accent-bg);color:var(--accent)}
.chips{display:flex;flex-wrap:wrap;gap:6px}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:42px;padding:0 16px;border-radius:12px;border:1px solid var(--line);background:var(--surface);font-weight:500}
.btn.pri{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}
.btn.bad{color:var(--bad)}
.btn.sm{min-height:34px;padding:0 12px;font-size:13px}
.seg{display:flex;gap:6px;overflow-x:auto;padding-bottom:2px;scrollbar-width:none}
.seg button{border:1px solid var(--line);background:var(--surface);border-radius:99px;padding:6px 14px;font-size:13px;font-weight:500;white-space:nowrap;color:var(--muted)}
.seg button[aria-pressed="true"]{background:var(--ink);border-color:var(--ink);color:var(--bg)}
.search{position:relative;margin-bottom:10px}
.search .ic{position:absolute;left:12px;top:11px;color:var(--muted)}
.search input{width:100%;height:42px;padding:0 14px 0 40px;border-radius:12px;border:1px solid var(--line);background:var(--surface)}
.empty{padding:28px 16px;text-align:center;color:var(--muted);border:1px dashed var(--line);border-radius:18px}
.empty b{display:block;color:var(--ink);font-family:var(--display);font-size:17px;margin-bottom:4px}
.bar{height:10px;border-radius:99px;background:var(--surface-2);overflow:hidden;display:flex}
.bar i{display:block;height:100%}
.bar .a{background:var(--accent)}.bar .g{background:var(--good)}.bar .w{background:var(--warn)}
.row{display:flex;align-items:center;gap:12px;padding:12px 0;border-top:1px solid var(--line);width:100%;background:none;border-inline:0;border-bottom:0;text-align:start}
.row:first-child{border-top:0}
.row .grow{flex:1;min-width:0}
.row .t{font-weight:500;overflow-wrap:anywhere}
.row .s{font-size:12.5px;color:var(--muted);overflow-wrap:anywhere}
.row .amt{text-align:end;font-weight:600;white-space:nowrap}
.rowbtn{flex:1;min-width:0;display:flex;align-items:center;gap:12px;background:none;border:0;padding:0;text-align:start;color:inherit}
.avatar{width:40px;height:40px;border-radius:12px;display:grid;place-items:center;background:var(--accent-bg);color:var(--accent);font-family:var(--display);font-weight:700}

/* project cards */
.cards{grid-template-columns:minmax(0,1fr)}
.pc{display:flex;flex-direction:column;gap:12px;text-align:start;width:100%;cursor:pointer}
.pc .hd{display:flex;justify-content:space-between;gap:10px;align-items:flex-start}
.pc .nm{font-family:var(--display);font-size:18px;font-weight:700;line-height:1.2;overflow-wrap:anywhere}
.pc .sv{color:var(--muted);font-size:12.5px}
.pc .mx{display:grid;grid-template-columns:1fr 1fr;gap:10px;padding:10px 12px;border-radius:12px;background:var(--surface-2)}
.pc .mx b{display:block;font-size:16px;font-weight:600}
.pc .ft{display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap}
.acts{display:flex;gap:6px}
.acts a,.acts button{display:grid;place-items:center;width:34px;height:34px;border-radius:10px;border:1px solid var(--line);background:var(--surface);color:var(--ink)}
.acts .off{opacity:.35;pointer-events:none}

/* ads budget */
.hero{display:grid;gap:14px}
.hero .big{font-family:var(--display);font-size:38px;font-weight:700;line-height:1;letter-spacing:-.02em}
.trio{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}
.trio div{min-width:0}
.trio b{display:block;font-size:15px;font-weight:600;overflow-wrap:anywhere}
.ar{font-size:11px;color:var(--muted);display:block}

/* sheet */
.sheet{position:fixed;inset:0;z-index:50;display:flex;align-items:flex-end;justify-content:center}
.scrim{position:absolute;inset:0;background:rgba(10,10,14,.5)}
.panel{position:relative;width:100%;max-width:560px;max-height:92vh;overflow:auto;background:var(--surface);border-radius:22px 22px 0 0;
  padding:10px 18px calc(18px + env(safe-area-inset-bottom,0px));box-shadow:var(--shadow)}
.grab{width:40px;height:4px;border-radius:9px;background:var(--line);margin:0 auto 10px}
.panel>header{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:12px}
.panel h2{font-family:var(--display);font-size:22px;font-weight:700;overflow-wrap:anywhere}
.fld{display:flex;flex-direction:column;gap:5px;margin-bottom:12px}
.fld label{font-size:12px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
.fld input,.fld select{height:44px;padding:0 12px;border-radius:12px;border:1px solid var(--line);background:var(--bg);width:100%;min-width:0}
.fld input[aria-invalid="true"]{border-color:var(--bad)}
.fld .err{color:var(--bad);font-size:12px}
.two{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.chk{display:flex;align-items:center;gap:10px;margin-bottom:14px;font-weight:500}
.chk input{width:22px;height:22px;accent-color:var(--accent)}
.hint{padding:10px 12px;border-radius:12px;background:var(--accent-bg);color:var(--accent);font-size:13px;margin-bottom:12px}
.dl{display:grid;gap:0;margin:0 0 14px}
.dl div{display:flex;justify-content:space-between;gap:16px;padding:10px 0;border-top:1px solid var(--line)}
.dl div:first-child{border-top:0}
.dl dt{color:var(--muted);font-size:13px;flex:none}
.dl dd{margin:0;text-align:end;overflow-wrap:anywhere;min-width:0}
.dl a{color:var(--accent);text-decoration:none;font-weight:500}
.foot{display:flex;gap:8px;flex-wrap:wrap}
.foot .btn{flex:1}
.fab{position:fixed;z-index:21;right:calc(16px + env(safe-area-inset-right,0px));bottom:calc(84px + env(safe-area-inset-bottom,0px));
  width:56px;height:56px;border-radius:18px;border:0;background:var(--accent);color:var(--accent-ink);display:grid;place-items:center;box-shadow:var(--shadow)}
.toast{position:fixed;z-index:60;left:50%;transform:translateX(-50%);bottom:calc(92px + env(safe-area-inset-bottom,0px));max-width:calc(100% - 32px);
  padding:10px 16px;border-radius:12px;background:var(--ink);color:var(--bg);font-weight:500;box-shadow:var(--shadow)}
html.lock{overflow:hidden}

@media (min-width:640px){
  .kpis{grid-template-columns:repeat(4,minmax(0,1fr))}
  .cards{grid-template-columns:repeat(2,minmax(0,1fr))}
  .sheet{align-items:center}.panel{border-radius:22px;padding-top:18px}.grab{display:none}
}
@media (min-width:900px){
  .app{grid-template-columns:220px minmax(0,1fr);column-gap:32px}
  .rail{position:sticky;top:0;left:auto;right:auto;bottom:auto;height:100vh;flex-direction:column;justify-content:flex-start;gap:6px;
    background:none;border:0;padding:28px 0}
  .brand{display:block;font-family:var(--display);font-weight:700;font-size:19px;line-height:1.15;margin-bottom:22px}
  .brand span{display:block;font-family:var(--body);font-size:10.5px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--muted);margin-top:6px}
  .tab{flex:none;flex-direction:row;gap:12px;font-size:14px;padding:11px 14px;justify-content:flex-start}
  .cards{grid-template-columns:repeat(3,minmax(0,1fr))}
  .fab{bottom:28px}.toast{bottom:28px}
  main{padding-bottom:100px}
}
@media (prefers-reduced-motion:no-preference){.panel{animation:up .22s ease-out}@keyframes up{from{transform:translateY(24px);opacity:0}}}
</style>
<div class="app">
  <nav class="rail" aria-label="Sections">
    <div class="brand">Business with Aimene<span>Projects</span></div>
    <button class="tab" data-tab="home" aria-current="page"><i data-ic="home"></i>Overview</button>
    <button class="tab" data-tab="projects"><i data-ic="folder"></i>Projects</button>
    <button class="tab" data-tab="ads"><i data-ic="wallet"></i>Ad budget</button>
    <button class="tab" data-tab="clients"><i data-ic="users"></i>Clients</button>
  </nav>
  <main>
    <header class="top">
      <div><div class="eyebrow" id="eyebrow"></div><h1 id="title"></h1></div>
      <button class="iconbtn" data-act="settings" aria-label="Rates and settings"><i data-ic="gear"></i></button>
    </header>
    <div id="banner" class="banner" hidden></div>
    <section id="v-home" data-view="home"></section>
    <section id="v-projects" data-view="projects" hidden>
      <div class="search"><i data-ic="search"></i><input id="q" type="search" placeholder="Search client, service or account" autocomplete="off" aria-label="Search projects"></div>
      <div class="seg" id="pfilters" role="group" aria-label="Filter projects"></div>
      <div id="plist" class="grid cards" style="margin-top:12px"></div>
