<script>
(function(){
'use strict';
var TYPE_ADS='ميزانية إعلانات', TYPE_SAL='راتب شهري';
var STATUSES=['In Progress','Pending','Done'];
var SERVICES=['Facebook ads','UI/UX','Media Buying','فيديو إعلاني ذكاء اصطناعي','تكاليف الموقع','الحساب الإعلاني'];
var ACCOUNTS=['ads nacera','ad03','ecomtest','adlyza','elora'];
var DEF={sell:350,cost:270,rate:275,recovered:0};
var S={tab:'home',q:'',pf:'all',projects:[],clients:[],ledger:[],spend:[],cfg:Object.assign({},DEF),loaded:{},db:null,dbOff:false};

var P={
 home:'<path d="M3 11l9-8 9 8"/><path d="M5 10v10h14V10"/>',
 folder:'<path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>',
 wallet:'<path d="M3 7a2 2 0 0 1 2-2h13v4"/><path d="M3 7v10a2 2 0 0 0 2 2h14a1 1 0 0 0 1-1v-9a1 1 0 0 0-1-1H5"/><circle cx="16" cy="13.5" r="1"/>',
 users:'<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6"/><path d="M16 4.7a3.5 3.5 0 0 1 0 6.6"/><path d="M18 14.5c2 .7 3.5 2.5 3.5 5.5"/>',
 plus:'<path d="M12 5v14M5 12h14"/>',
 search:'<circle cx="11" cy="11" r="6.5"/><path d="M20 20l-4.2-4.2"/>',
 x:'<path d="M6 6l12 12M18 6L6 18"/>',
 chat:'<path d="M4 5h16v11H9l-5 4z"/>',
 ext:'<path d="M14 4h6v6"/><path d="M20 4l-9 9"/><path d="M18 14v5H5V6h5"/>',
 copy:'<rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5h10"/>',
 gear:'<circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M4.9 19.1L7 17M17 7l2.1-2.1"/>',
 edit:'<path d="M4 20h4L19 9l-4-4L4 16z"/><path d="M13.5 6.5l4 4"/>',
 fb:'<path d="M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v6h4v-6h3l1-4h-4V8.5A.5.5 0 0 1 14 8z"/>'
};
function ic(n){return '<svg class="ic" viewBox="0 0 24 24" aria-hidden="true">'+P[n]+'</svg>'}
function $(s,r){return (r||document).querySelector(s)}
function esc(s){return String(s==null?'':s).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}
var nf0=new Intl.NumberFormat('en-US',{maximumFractionDigits:0}), nf2=new Intl.NumberFormat('en-US',{minimumFractionDigits:2,maximumFractionDigits:2});
function r2(n){return Math.round((+n||0)*100)/100}
function fmt(n){n=r2(n);return Number.isInteger(n)?nf0.format(n):nf2.format(n)}
function dzd(n){return '<span class="num">'+fmt(n)+'</span> <small>DZD</small>'}
function eur(n){return '<span class="num">'+nf2.format(+n||0)+'</span> <small>€</small>'}
function safeUrl(u){u=String(u||'').trim();return /^https?:\/\//i.test(u)?u:''}
function waLink(p){var d=String(p||'').replace(/\D/g,'');if(!d)return '';if(d.charAt(0)==='0')d=d.slice(1);if(d.length===9)d='213'+d;return 'https://wa.me/'+d}
function fdate(s){var m=/^(\d{4})-(\d{2})-(\d{2})$/.exec(s||'');if(!m)return s||'';return new Date(+m[1],+m[2]-1,+m[3]).toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'})}
function np(b){var c=S.cfg;b=+b||0;return r2(b-(b/(c.sell||1))*c.cost)}
function uid(p){return p+Date.now().toString(36)+Math.random().toString(36).slice(2,5)}
function today(){var d=new Date();return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0')}
function plural(n,w){return n+' '+w+(n===1?'':'s')}
function byId(list,id){for(var i=0;i<list.length;i++)if(list[i].id===id)return list[i];return null}
function sum(list,f){return list.reduce(function(a,x){return a+(f(x)||0)},0)}
function isPaid(p){return p.payment==='Paid'}
function stCls(s){return s==='Done'?'good':s==='Pending'?'warn':'acc'}
function sorted(){return S.projects.slice().sort(function(a,b){return String(b.date||'').localeCompare(String(a.date||''))||String(a.client).localeCompare(String(b.client))})}
function byN(a,b){return (a.n||0)-(b.n||0)}

function totals(){
  var rec=0,sal=0,sp=0;
  S.ledger.forEach(function(l){if(l.type===TYPE_SAL)sal+=+l.amount||0;else rec+=+l.amount||0});
  S.spend.forEach(function(x){sp+=(+x.eur||0)*(+x.rate||S.cfg.rate)});
  return {rec:r2(rec),sal:r2(sal),sp:r2(sp),left:r2(rec-sp)};
}

/* ---------- views ---------- */
function renderHeader(){
  var n=S.projects.length, meta={
    home:['Business with Aimene','Overview'],
    projects:[plural(n,'project'),'Projects'],
    ads:['Kartabli','Ad budget'],
    clients:[plural(S.clients.length,'client'),'Clients']}[S.tab];
  $('#eyebrow').textContent=meta[0];$('#title').textContent=meta[1];
}

function loading(what){return S.dbOff?'<div class="empty"><b>Data unavailable</b>Open this page inside claude.ai while signed in.</div>':'<div class="empty"><b>Loading '+what+'</b>Your saved data is on its way.</div>'}

function renderHome(){
  var el=$('#v-home');
  if(!S.loaded.projects){el.innerHTML=loading('your overview');return}
  var ps=S.projects, open=ps.filter(function(p){return p.status!=='Done'}).length;
  var budget=sum(ps,function(p){return +p.budget}), net=sum(ps,function(p){return np(p.budget)});
