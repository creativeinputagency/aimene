  }else if(k==='client'){
    var name=v('f-name');if(!name)return bad('f-name','Enter a client name.');
    var oc=id?A.byId(S.clients,id):null;
    job=save('clients',id||A.uid('c'),Object.assign({},oc?clean(oc):{n:Date.now()},{name:name}),id?'Client updated':'Client added').then(function(ok){
      if(ok&&oc&&oc.name!==name){return Promise.all(S.projects.filter(function(p){return p.client===oc.name}).map(function(p){return patch('projects',p.id,{client:name})}))}});
  }else if(k==='ledger'){
    var amt=num('f-amount');if(!(amt>=0))return bad('f-amount','Enter the amount in DZD.');
    var ol=id?A.byId(S.ledger,id):null;
    job=save('ledger',id||A.uid('l'),Object.assign({},ol?clean(ol):{n:Date.now()},{label:v('f-label'),amount:amt,type:v('f-type'),note:v('f-note'),date:v('f-ldate')}),id?'Entry updated':'Entry added');
  }else if(k==='spend'){
    var eu=num('f-eur'),rt=num('f-rate');
    if(!v('f-sname'))return bad('f-sname','Enter a campaign or account name.');
    if(!(eu>=0))return bad('f-eur','Enter the amount in euros.');
    if(!(rt>0))return bad('f-rate','Enter the exchange rate.');
    var ox=id?A.byId(S.spend,id):null;
    job=save('spend',id||A.uid('s'),Object.assign({},ox?clean(ox):{n:Date.now()},{name:v('f-sname'),eur:eu,rate:rt}),id?'Spend updated':'Spend added');
  }else if(k==='settings'){
    var s1=num('f-sell'),s2=num('f-cost'),s3=num('f-drate'),s4=num('f-rec');
    if(!(s1>0))return bad('f-sell','Enter a rate above zero.');
    if(!(s2>=0))return bad('f-cost','Enter a rate of zero or more.');
    if(!(s3>0))return bad('f-drate','Enter a rate above zero.');
    job=save('settings','main',{sell:s1,cost:s2,rate:s3,recovered:s4>=0?s4:0},'Settings saved');
  }
  if(job)job.then(function(){closeSheet()});
});

/* ---------- clicks ---------- */
document.addEventListener('input',function(e){
  if(e.target.id==='q'){S.q=e.target.value;A.render()}
  if(e.target.id==='f-budget')updNp();
  if(e.target.id==='f-sell'||e.target.id==='f-cost'){var h=$('#f-sh');if(h)h.textContent='Net profit = budget − budget ÷ '+(v('f-sell')||'?')+' × '+(v('f-cost')||'?')}
});
document.addEventListener('keydown',function(e){
  if(e.key==='Escape'&&!sheet.hidden)closeSheet();
  if((e.key==='Enter'||e.key===' ')&&e.target.matches&&e.target.matches('article[data-act="open"]')){e.preventDefault();detail(e.target.getAttribute('data-id'))}
});
document.addEventListener('click',function(e){
  if(e.target.closest('a'))return;
  var t=e.target.closest('[data-act],[data-tab]');if(!t)return;
  var tab=t.getAttribute('data-tab');if(tab){if(!sheet.hidden)closeSheet();A.setTab(tab);return}
  var act=t.getAttribute('data-act'),id=t.getAttribute('data-id');
  switch(act){
    case 'open':detail(id);break;
    case 'close':closeSheet();break;
    case 'add':if(S.tab==='clients')clientForm();else projectForm();break;
    case 'pf':S.pf=t.getAttribute('data-v');A.render();break;
    case 'settings':settingsForm();break;
    case 'add-ledger':ledgerForm();break;
    case 'edit-ledger':ledgerForm(A.byId(S.ledger,id));break;
    case 'add-spend':spendForm();break;
    case 'edit-spend':spendForm(A.byId(S.spend,id));break;
    case 'add-client':clientForm();break;
    case 'edit-client':clientForm(A.byId(S.clients,id));break;
    case 'edit-project':projectForm(A.byId(S.projects,id));break;
    case 'client-projects':S.q=t.getAttribute('data-name');S.pf='all';$('#q').value=S.q;A.setTab('projects');break;
    case 'toggle-paid':var p1=A.byId(S.projects,id);if(p1)patch('projects',id,{payment:A.isPaid(p1)?'Unpaid':'Paid'},'Payment updated').then(closeSheet);break;
    case 'toggle-facture':var p2=A.byId(S.projects,id);if(p2)patch('projects',id,{facture:!p2.facture},'Facture updated').then(closeSheet);break;
    case 'copy':
      if(navigator.clipboard&&navigator.clipboard.writeText)navigator.clipboard.writeText(t.getAttribute('data-t')).then(function(){toast('Copied')},function(){toast('Copy is blocked here. Select the number to copy it.')});
      else toast('Copy is blocked here. Select the number to copy it.');break;
    case 'del':
      if(t.getAttribute('data-armed')){
        if(!S.db){toast('Saving is not available in this view.');break}
        S.db.collection(t.getAttribute('data-coll')).doc(id).delete().then(function(){toast('Deleted');closeSheet()},function(){toast('Could not delete. Try again.')});
      }else{
        t.setAttribute('data-armed','1');t.textContent='Tap again to delete';
        setTimeout(function(){if(t.isConnected){t.removeAttribute('data-armed');t.textContent='Delete'}},4000);
      }break;
  }
});

/* ---------- live data ---------- */
function off(){S.dbOff=true;var b=$('#banner');b.textContent='Your data is not available in this view. Open this page inside claude.ai while signed in to see and edit it.';b.hidden=false;A.render()}
function sub(coll,key){
  S.db.collection(coll).onSnapshot(function(snap){
    S[key]=snap.docs.map(function(d){var o=Object.assign({},d.data());o.id=d.id;return o});
    S.loaded[key]=true;A.render();
  },function(){off()});
}
(function boot(){
  fillIcons(document);
  var t='home';try{t=localStorage.getItem('bwa-tab')||'home'}catch(e){}
  if(['home','projects','ads','clients'].indexOf(t)<0)t='home';
  A.setTab(t);
  if(!(window.claude&&window.claude.use)){off();return}
  window.claude.use('db').then(function(db){
    if(!db){off();return}
    S.db=db;
    sub('projects','projects');sub('clients','clients');sub('ledger','ledger');sub('spend','spend');
    db.doc('settings/main').onSnapshot(function(s){S.cfg=Object.assign({},C.DEF,s.exists?s.data():{});S.loaded.cfg=true;A.render()},function(){off()});
  },function(){off()});
})();
})();
</script>

